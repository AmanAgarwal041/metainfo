# Optional server-side DataForSEO keys (users can also bring their own in Settings).
# DataForSEO powers search volumes, rankings, competitors, backlinks and AI answers.
# Free features (site audit, autocomplete keyword ideas, content gap, audit comparison) work without it.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=          # API password from https://app.dataforseo.com/api-access
# DATAFORSEO_API_URL=https://sandbox.dataforseo.com/v3/   # free sandbox with dummy data, for testing

# Recommended when deployed with server keys: using them then requires this token.
# Requests that bring their own DataForSEO keys don't need it.
RESEARCH_TOKEN=

# Optional Scrapling service (scraper/): renders pages in a headless browser to measure what
# crawlers that don't run JavaScript miss, and crawls whole sites server-side. Without it, audits
# use a heuristic for JavaScript-only pages and site crawls run page by page through this app.
# SCRAPER_URL=http://127.0.0.1:8000
# SCRAPER_TOKEN=                # must match the service's SCRAPER_TOKEN

# Optional sign-in with Clerk (saves projects and history to an account; everything works without it).
# Needs the D1 database (wrangler.jsonc) and a Clerk application with Organizations turned on
# ("Membership optional", so people get a personal workspace). Keys from dashboard.clerk.com → API keys.
# The publishable key is read at build time.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_KEY=                 # optional: the PEM public key, to verify sessions without calling Clerk
# APP_URL=https://metainfo.example.com   # optional: extra origin allowed to send session tokens

# Allow scanning private/loopback hosts (local development only).
# ALLOW_PRIVATE_HOSTS=1
