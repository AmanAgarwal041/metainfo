# Optional server-side DataForSEO keys (users can also bring their own in Settings).
# DataForSEO powers search volumes, rankings, competitors, backlinks and AI answers.
# Free features (site audit, autocomplete keyword ideas, content gap, audit comparison) work without it.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=          # API password from https://app.dataforseo.com/api-access
# DATAFORSEO_API_URL=https://sandbox.dataforseo.com/v3/   # free sandbox with dummy data, for testing

# Recommended when deployed with server keys: using them then requires this token.
# Requests that bring their own DataForSEO keys don't need it.
RESEARCH_TOKEN=

# Allow scanning private/loopback hosts (local development only).
# ALLOW_PRIVATE_HOSTS=1
