{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metainfo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-01",
  // nodejs_compat: Next.js server APIs. global_fetch_strictly_public: the scanner
  // can only reach the public internet, which is the SSRF guard on Workers.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "metainfo"
    }
  ],
  // Accounts, organisations and synced workspaces (sign-in is optional).
  // Apply migrations with: npx wrangler d1 migrations apply metainfo --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metainfo",
      "database_id": "b9def348-04b9-4d91-b6ff-5b75f1bb0704",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (optional): wrangler secret put DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD / RESEARCH_TOKEN
  // Sign-in: APP_URL, AUTH_SECRET, and GOOGLE_AUTH_CLIENT_ID/SECRET and/or GITHUB_AUTH_CLIENT_ID/SECRET
}
