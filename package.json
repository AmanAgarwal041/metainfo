{
  "name": "metainfo",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-wasm.mjs && next dev",
    "build": "npm run build:wasm && next build",
    "start": "next start",
    "build:wasm": "wasm-pack build wasm --target web --out-dir pkg --out-name metainfo --release && node scripts/copy-wasm.mjs",
    "test": "cargo test --manifest-path wasm/Cargo.toml",
    "lint": "eslint . && cargo clippy --manifest-path wasm/Cargo.toml -- -D warnings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3",
    "wasm-pack": "^0.15.0"
  }
}
